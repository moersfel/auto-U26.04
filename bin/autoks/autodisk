#!/bin/bash
# Slightly modified from original disk script to support  
# auto ks utilities

#first clean things up
clean >& /dev/null

# Get environment variables
. ./ks_environment.sh

if [ $# -lt 1 ]; then
    echo "Usage: ./autodisk machine_name (without cs.ucdavis.edu)"
    exit 1
fi

#IP_ADDRESS=`dig $1.cs.ucdavis.edu +sh`

# Get the IP address of the target machine for the kickstart installation.
IP_ADDRESS=`nslookup -sil $1.cs.ucdavis.edu 2> /dev/null | head -5 | tail -1 | awk '{ print $2 }'`

x=`echo $IP_ADDlESS | sed 's/^[0-9]\+\.[0-9]\+\.[0-9]\+\.[0-9]\+$//'`
if [ ! -z "$x" ]; then
    echo IP address lookup for host $1 failed. 2>&1
    exit 1
fi

#echo "Creating configuration file..."
# Delete /tmp/ks.cfg just in case
if [ -f /tmp/ks.cfg ]; then
    rm -f /tmp/ks.cfg
fi

# Do search and replaces
cat kickstart |\
sed 's,<IP_ADDRESS>,'$IP_ADDRESS',' |\
sed 's,<ISO_SERVER>,'$ISO_SERVER',' |\
sed 's,<ISO_PATH>,'$ISO_PATH',' |\
sed 's,<SUBNET_MASK>,'$SUBNET_MASK',' |\
sed 's,<GATEWAY>,'$GATEWAY',' |\
sed 's,<NAME_SERVER>,'$NAME_SERVER',' |\
sed 's,<NIS_SERVER>,'$NIS_SERVER',' |\
sed 's,<NIS_DOMAIN>,'$NIS_DOMAIN',' > /tmp/ks.cfg

# Append rest of info
cat ks_environment.sh >> /tmp/ks.cfg
cat post_install >> /tmp/ks.cfg

echo "Creating boot disk for $1, IP: $IP_ADDRESS"

if [ -f ksimage ]; then
   # then ksimage already exists, use it 
   echo "modifying pre-existing ksimage"
   copyKS ksimage /tmp/ks.cfg  # also referenced in mkFinal
 else
   # then ksimage does not exists
   echo "ksimage does not exist - creating it"   
   mkFinal rh90_image /tmp/ks.cfg
fi
   
# produces ksimage
# now, copy ksimage, deploy, ks_lilo.conf to ks machine's /tmp directory

read -p "About to deploy payload. Hit ENTER to proceed."
scp ksimage deploy ks_lilo.conf $1:/tmp
ssh $1 /tmp/deploy  # do the ks



