# Because the new system disk is mounted on /target now
#export TARGET=/target

###############################################################################
# Script that configures system and installs packages
###############################################################################
mkdir -p $LOG_DIR

echo "###############"
echo "Starting kickit_first"
echo "###############"

mkdir -p $KICKSTART_MNT
#/bin/mount -t nfs -o vers=3,nolock $KICKSTART_SERVER:$KICKSTART_PATH $KICKSTART_MNT >> $LOG_DIR/mount_com 2>&1

