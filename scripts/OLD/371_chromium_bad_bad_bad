echo "Remove snap chromium\n"
apt -y remove chromium-browser chromium-browser-l10n chromium-codecs-ffmpeg-extra

echo "Import the chromium APT repo signing key (if wget is missing, install it first):\n"

echo "deb [arch=amd64 trusted=yes] http://deb.debian.org/debian bookworm main non-free-firmware" > /etc/apt/sources.list.d/debian.list
echo "deb [arch=amd64 trusted=yes] http://deb.debian.org/debian bookworm-updates main non-free-firmware" >> /etc/apt/sources.list.d/debian.list
echo "deb [arch=amd64 trusted=yes] http://deb.debian.org/debian-security bookworm-security main non-free-firmware" >> /etc/apt/sources.list.d/debian.list


