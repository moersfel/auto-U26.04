echo "Make non-snap repo the priority\n"
echo 'Package: * \n Pin: origin deb.debian.org    \n Pin-Priority: -1 \n  \n Package: chromium* \n Pin: origin deb.debian.org \n Pin-Priority: 999 \n  \n Package: libjpeg62-turbo* \n Pin: origin deb.debian.org \n Pin-Priority: 999 \n  \n Package: libdav1d6* \n Pin: origin deb.debian.org \n Pin-Priority: 999 \n  \n Package: chromium* \n Pin: origin us.archive.ubuntu.com \n Pin-Priority: -1 \n  \n ' | sudo tee /etc/apt/preferences.d/chromium.pref


